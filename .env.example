# multi_app_v2 — variables de entorno (copiar a .env; NO versionar .env)

# --- Base de datos (MariaDB 11.8.3) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=multi_app_v2
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
# DB_SOCKET tiene prioridad sobre host/port si se define (ej. XAMPP/producción):
# DB_SOCKET=/Applications/XAMPP/xamppfiles/var/mysql/mysql.sock

# --- Aplicación ---
APP_ENV=local            # local | test | production (local=sidebar negro · test=sidebar rojo · production=azul)
APP_URL=http://localhost/projects/multi_app_v2
SESSION_LIFETIME=3600    # segundos de inactividad

# --- Almacenamiento / uploads (regla 2.1 / 2.2: límites editables por entorno) ---
UPLOAD_MAX_IMAGE_MB=5
UPLOAD_MAX_PDF_MB=10
UPLOAD_MAX_MEDIA_MB=20   # audio/video/office para WhatsApp/email
UPLOAD_DIR=uploads       # raíz de almacenamiento (idealmente fuera del webroot)

# --- Almacenamiento híbrido Local + R2 ---
# tienda/cargas/convenios → SIEMPRE local (LocalDriver, directo en el server; no van a R2).
# creditos,pagos,boletas,solicitudes,cobranza,fondo → r2 (sensibles).
STORAGE_DRIVERS=tienda:local,cargas:local,convenios:local,creditos:r2,pagos:r2,boletas:r2,solicitudes:r2,cobranza:r2,fondo:r2,comunicaciones:local
# R2_DISABLE=1 fuerza Local en todo (rollback instantáneo).
R2_DISABLE=0
# Credenciales de R2 (NUNCA en código / versionado). El endpoint se arma como
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com (o se define R2_ENDPOINT a mano).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# bucket con los objetos sensibles
R2_BUCKET=
R2_ENDPOINT=

# --- Correo SMTP ---
SMTP_HOST=mail.coomultiunion.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@coomultiunion.com
# HELO/Message-ID (por defecto usa SMTP_HOST)
SMTP_HELO=
# MAIL_FROM es respaldo de SMTP_FROM si no está definido.
MAIL_ATENCION=atenciongalerias@coomultiunion.com
MAIL_SOLICITUDES=solicitudes@coomultiunion.com

# --- Seguridad ---
PASSWORD_ROTATION_DAYS=30

# --- Asistente IA (chat del portal) ---
# La API key es un SECRETO: solo en .env del servidor (nunca versionado).
AI_CHAT_ENABLED=1
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
AI_CHAT_TEMPERATURE=0.2
AI_CHAT_MAX_TOKENS=800
AI_CHAT_HISTORY_LIMIT=6
AI_CHAT_TIMEOUT=30
AI_CHAT_CONNECT_TIMEOUT=10
AI_CHAT_MAX_INPUT=1500
AI_CHAT_RATE_MAX=30
AI_CHAT_RATE_WINDOW=3600
AI_CHAT_SESSION_TTL=15          # minutos de inactividad para cerrar una conversación
AI_CHAT_TOOLS=1                 # herramientas del asistente (consultar datos / crear solicitudes)
AI_CHAT_NOMBRE=Soli             # nombre visible del asistente

# --- Comunicaciones (Twilio + SendGrid) ---
# REST: API Key SID/Secret (recomendado). Auth Token: obligatorio para validar webhooks.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_TRIAL=1                  # 1 = mostrar advertencias de cuenta trial
TWILIO_DRY_RUN=0                # 1 = simular envíos (no llama a Twilio)
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=           # whatsapp:+... (sandbox o sender aprobado)
TWILIO_MESSAGING_SERVICE_SID=   # Messaging Service para SMS
TWILIO_WHATSAPP_MESSAGING_SERVICE_SID= # Messaging Service para WhatsApp (opcional)
TWILIO_STATUS_CALLBACK_URL=     # ej. https://dominio/api/comunicaciones/webhooks/status.php
TWILIO_INBOUND_CALLBACK_URL=    # ej. https://dominio/api/comunicaciones/webhooks/inbound.php
TWILIO_VALIDATE_SIGNATURE=1
TWILIO_TIMEOUT=30
TWILIO_CONNECT_TIMEOUT=10

# SendGrid (opcional/futuro). El canal email usa SMTP por defecto (SMTP_* arriba).
SENDGRID_API_KEY=
SENDGRID_FROM=
SENDGRID_FROM_NAME=Coomultiunion
SENDGRID_EVENT_WEBHOOK_SECRET=
SENDGRID_TIMEOUT=30
SENDGRID_CONNECT_TIMEOUT=10

# Secreto para URLs firmadas de adjuntos y baja de email.
# Si se omite, se deriva de TWILIO_AUTH_TOKEN.
COM_MEDIA_SECRET=

# --- API por tokens (integraciones externas / curl) ---
# Habilita la autenticación por Bearer token en los endpoints autorizados.
API_TOKEN_ENABLED=1
# Vigencia por defecto (días) y máximo permitido al crear un token (expiración obligatoria).
API_TOKEN_DIAS_DEFAULT=180
API_TOKEN_MAX_DIAS=365
# Exigir HTTPS para peticiones con token (por defecto 1 en production, 0 fuera).
API_TOKEN_HTTPS_ONLY=0
# Límite de solicitudes por token (0 desactiva). Ventana en segundos.
API_TOKEN_RATE_MAX=120
API_TOKEN_RATE_WINDOW=60
